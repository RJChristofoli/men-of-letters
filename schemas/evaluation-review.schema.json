{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RJChristofoli/men-of-letters/schemas/evaluation-review.schema.json",
  "title": "Men of Letters blinded evaluation review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "case_id",
    "configuration",
    "reviewer",
    "role",
    "blinded",
    "preference",
    "reason",
    "baseline_sha256",
    "capability_sha256",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "configuration": {
      "enum": ["individual-capability", "complete-core-policies", "phase-1-combined"]
    },
    "reviewer": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" },
    "role": { "enum": ["primary", "adjudicator"] },
    "blinded": { "const": true },
    "preference": { "enum": ["baseline", "capability", "tie"] },
    "reason": { "type": "string", "minLength": 10 },
    "baseline_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "capability_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "created_at": { "type": "string", "minLength": 20 }
  }
}
