{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RJChristofoli/men-of-letters/schemas/evaluation-run.schema.json",
  "title": "Men of Letters evaluation run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "capability",
    "variant",
    "timestamp",
    "environment",
    "metrics",
    "checks",
    "passed",
    "response"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "capability": { "type": "string", "minLength": 1 },
    "variant": { "enum": ["baseline", "capability"] },
    "configuration": {
      "enum": ["individual-capability", "complete-core-policies", "phase-1-combined"]
    },
    "timestamp": { "type": "string", "minLength": 20 },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex_cli", "node", "platform"],
      "properties": {
        "codex_cli": { "type": "string", "minLength": 1 },
        "node": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "model": { "type": ["string", "null"], "minLength": 1 },
        "reasoning_effort": { "type": ["string", "null"], "minLength": 1 },
        "model_metadata_source": { "enum": ["explicit-cli", "not-reported"] }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sandbox", "ephemeral", "user_config_ignored", "output_schema"],
      "properties": {
        "sandbox": { "enum": ["read-only", "workspace-write", "danger-full-access"] },
        "ephemeral": { "const": true },
        "user_config_ignored": { "const": true },
        "output_schema": { "type": "string", "minLength": 1 }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "total_tokens",
        "turns",
        "tool_calls",
        "latency_ms",
        "correction_turns"
      ],
      "properties": {
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cached_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "turns": { "type": "integer", "minimum": 0 },
        "tool_calls": { "type": "integer", "minimum": 0 },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "correction_turns": { "type": "integer", "minimum": 0 }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "passed", "detail"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    },
    "passed": { "type": "boolean" },
    "response": {}
  }
}
