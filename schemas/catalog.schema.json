{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RJChristofoli/men-of-letters/schemas/catalog.schema.json",
  "title": "Men of Letters capability catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capabilities"],
  "properties": {
    "schema_version": { "const": 1 },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/capability" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "status",
        "owner",
        "source",
        "dependencies",
        "compatibility",
        "evaluation_suite",
        "installation_pack",
        "introduced_release",
        "deprecated_release",
        "context_budget_tokens"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": {
          "enum": ["policy", "router", "workflow", "reference", "resource"]
        },
        "status": {
          "enum": [
            "proposed",
            "experimental",
            "validated",
            "stable",
            "deprecated",
            "retired"
          ]
        },
        "owner": { "type": "string", "minLength": 1 },
        "source": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "dependencies": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "evaluation_suite": {
          "oneOf": [
            { "$ref": "#/$defs/id" },
            { "type": "null" }
          ]
        },
        "installation_pack": { "$ref": "#/$defs/id" },
        "introduced_release": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "deprecated_release": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "context_budget_tokens": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
