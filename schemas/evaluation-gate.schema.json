{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RJChristofoli/men-of-letters/schemas/evaluation-gate.schema.json",
  "title": "Men of Letters pre-registered evaluation gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "status",
    "registered_on",
    "scope",
    "comparability",
    "quality",
    "tokens",
    "regressions",
    "matrix",
    "exit_gate"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "const": "phase-1-materiality" },
    "status": { "const": "preregistered" },
    "registered_on": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilities", "configurations"],
      "properties": {
        "capabilities": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
          "minItems": 1,
          "uniqueItems": true
        },
        "configurations": {
          "type": "array",
          "items": {
            "enum": ["individual-capability", "complete-core-policies", "phase-1-combined"]
          },
          "minItems": 3,
          "uniqueItems": true
        }
      }
    },
    "comparability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "same_case_and_prompt",
        "same_output_schema_and_checks",
        "same_model_host_and_configuration",
        "fresh_case_families",
        "randomized_blinded_order",
        "thresholds_frozen_before_expanded_runs"
      ],
      "properties": {
        "same_case_and_prompt": { "const": true },
        "same_output_schema_and_checks": { "const": true },
        "same_model_host_and_configuration": { "const": true },
        "fresh_case_families": { "const": true },
        "randomized_blinded_order": { "const": true },
        "thresholds_frozen_before_expanded_runs": { "const": true }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_if",
        "objective_pass_rate_delta_min_percentage_points",
        "capability_objective_pass_rate_min",
        "capability_preference_rate_min",
        "baseline_preference_rate_max",
        "non_regression_baseline_preference_rate_max",
        "blinded_reviewers_min",
        "adjudicate_disagreements"
      ],
      "properties": {
        "material_if": { "const": "objective-or-preference" },
        "objective_pass_rate_delta_min_percentage_points": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "capability_objective_pass_rate_min": { "const": 1 },
        "capability_preference_rate_min": {
          "type": "number",
          "exclusiveMinimum": 0.5,
          "maximum": 1
        },
        "baseline_preference_rate_max": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 0.5
        },
        "non_regression_baseline_preference_rate_max": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 0.5
        },
        "blinded_reviewers_min": { "type": "integer", "minimum": 2 },
        "adjudicate_disagreements": { "const": true }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicable_aggregate_reduction_min",
        "applicable_paired_improvement_rate_min",
        "unrelated_aggregate_overhead_max",
        "unrelated_single_case_overhead_max"
      ],
      "properties": {
        "applicable_aggregate_reduction_min": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "applicable_paired_improvement_rate_min": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1
        },
        "unrelated_aggregate_overhead_max": { "type": "number", "minimum": 0, "maximum": 1 },
        "unrelated_single_case_overhead_max": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "regressions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "safety_failures_max",
        "false_triggers_max",
        "correction_turns_aggregate_delta_max",
        "unnecessary_tool_call_delta_max",
        "median_latency_relative_increase_max"
      ],
      "properties": {
        "safety_failures_max": { "const": 0 },
        "false_triggers_max": { "const": 0 },
        "correction_turns_aggregate_delta_max": { "const": 0 },
        "unnecessary_tool_call_delta_max": { "const": 0 },
        "median_latency_relative_increase_max": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "target", "kind", "minimum_case_pairs", "dimensions"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
          "target": {
            "enum": [
              "each-retained-policy",
              "complete-core-policies",
              "engineering-discovery",
              "phase-1-combined"
            ]
          },
          "kind": { "enum": ["positive", "negative", "precedence"] },
          "minimum_case_pairs": { "type": "integer", "minimum": 1 },
          "dimensions": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    },
    "exit_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "individual_incremental_value",
        "token_value_requires_quality_non_regression",
        "combined_material_gain",
        "retained_lifecycle_minimum",
        "required_installation_checks",
        "failed_gate_action"
      ],
      "properties": {
        "individual_incremental_value": { "const": "quality-or-token" },
        "token_value_requires_quality_non_regression": { "const": true },
        "combined_material_gain": { "const": "quality-and-token" },
        "retained_lifecycle_minimum": { "const": "validated" },
        "required_installation_checks": {
          "type": "array",
          "items": { "enum": ["install", "update", "doctor", "uninstall", "rollback"] },
          "minItems": 5,
          "uniqueItems": true
        },
        "failed_gate_action": { "const": "revise-narrow-or-retire" }
      }
    }
  }
}
