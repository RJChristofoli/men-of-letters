{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "safety_controls_required",
    "efficiency_may_override",
    "resolution",
    "next_action"
  ],
  "properties": {
    "safety_controls_required": { "type": "boolean" },
    "efficiency_may_override": { "type": "boolean" },
    "resolution": { "type": "string", "minLength": 1 },
    "next_action": { "type": "string", "minLength": 1 }
  }
}
