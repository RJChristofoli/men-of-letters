{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "release",
    "evidence",
    "verification",
    "rollback",
    "ignored_context"
  ],
  "properties": {
    "decision": { "enum": ["go", "no-go", "blocked"] },
    "release": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 3
    },
    "verification": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 2
    },
    "rollback": { "type": "string", "minLength": 1 },
    "ignored_context": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    }
  }
}
