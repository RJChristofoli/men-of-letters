{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "component_status", "blocker", "next_action"],
  "properties": {
    "decision": { "enum": ["ready", "blocked"] },
    "component_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "worker", "database", "web"],
      "properties": {
        "api": { "enum": ["ready", "blocked"] },
        "worker": { "enum": ["ready", "blocked"] },
        "database": { "enum": ["ready", "blocked"] },
        "web": { "enum": ["ready", "blocked"] }
      }
    },
    "blocker": { "type": "string", "minLength": 1 },
    "next_action": { "type": "string", "minLength": 1 }
  }
}
