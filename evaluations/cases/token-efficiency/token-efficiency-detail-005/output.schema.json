{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["area", "evidence", "risk", "action"],
        "properties": {
          "area": { "enum": ["architecture", "security", "data", "operations", "rollback"] },
          "evidence": { "type": "string", "minLength": 1 },
          "risk": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
