{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "root_problem",
    "constraints",
    "preserve_behavior",
    "tradeoffs",
    "uncertainty",
    "validation"
  ],
  "properties": {
    "decision": {
      "enum": [
        "accept-requested-solution",
        "use-smaller-compatible-change",
        "defer-pending-evidence",
        "cannot-decide"
      ]
    },
    "root_problem": { "type": "string", "minLength": 1 },
    "constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 2
    },
    "preserve_behavior": { "type": "boolean" },
    "tradeoffs": { "type": "string", "minLength": 1 },
    "uncertainty": { "type": "string", "minLength": 1 },
    "validation": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 2
    }
  }
}
