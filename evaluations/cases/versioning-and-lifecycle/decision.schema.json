{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "classification",
    "version_effect",
    "status_effect",
    "consumers",
    "migration",
    "rollback",
    "notice",
    "evidence_required"
  ],
  "properties": {
    "classification": { "enum": ["non-breaking", "breaking", "unknown", "not-applicable"] },
    "version_effect": { "enum": ["none", "patch", "minor", "major", "repository-defined", "unknown"] },
    "status_effect": {
      "enum": [
        "none",
        "keep-current",
        "propose-promotion",
        "propose-deprecation",
        "propose-retirement",
        "unknown"
      ]
    },
    "consumers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "migration": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "rollback": { "type": "string", "minLength": 1 },
    "notice": { "type": "string", "minLength": 1 },
    "evidence_required": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
